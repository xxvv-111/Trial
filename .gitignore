# ===== Unity 生成的缓存（不该进仓库，每次打开都会重建）=====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/

# ===== Unity 崩溃报告 =====
/[Cc]rashReport/

# ===== 生成的 IDE 工程文件（VS / Rider 会自己生成）=====
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
.opendb
*.VC.db
.vsconfig

# ===== 编辑器 / 系统杂项 =====
.idea/
.vs/
.vscode/
.DS_Store
Thumbs.db

# ===== 第三方资源包（不进仓库）=====
# TKDstyle_AnimSet：第三方武术动画包，257 MB（占 Assets 的 92%），另有署名/授权要求。
# 已确认 TKD 之外无任何资源引用它 —— 游戏实际使用的动画已抽成独立 .anim 文件放在
# Assets/_Game/Art/Animations/，模型在 Assets/_Game/Art/characters/。故可安全排除。
# 本地保留即可；克隆仓库后需自行放回，才能打开 TKD 自带的演示场景与 controller。
/Assets/TKDstyle_AnimSet/
/Assets/TKDstyle_AnimSet.meta

# ===== 引擎私有格式（Unity 读不了，不进仓库）=====
# Roskva 角色包里的 .psa（动画）/ .psk（模型）是 Unreal 格式，Unity 无法导入，
# 共约 26 MB。游戏实际使用 TKD 的 Humanoid 动画（重定向到 Roskva），故可安全排除。
# 本地保留即可；若日后要用 Roskva 自带动作，需经 Blender 插件转成 FBX。
*.psa
*.psa.meta
*.psk
*.psk.meta
